        "foregroundColor" : "#3d3833"
    },
    "blockquote" : {
        "backgroundColor" : "#f3eee4",
        "foregroundColor" : "#5c564e"
    },
    "codeBlock" : {
        "backgroundColor" : "#f0ebe3",
        "foregroundColor" : "#6b2d2d",
        "fontName" : "Menlo",
        "fontScale" : 0.92,
        "mono" : 1
    },
    "codeSpan" : {
        "backgroundColor" : "#f0ebe3",
        "foregroundColor" : "#6b2d2d",
        "fontName" : "Menlo",
        "fontScale" : 0.92,
        "mono" : 1
    },
    "heading" : {
        "bold" : 1,
        "foregroundColor" : "#8c3a32"
    },
