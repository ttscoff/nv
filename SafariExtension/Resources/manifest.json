{
  "manifest_version": 3,
  "name": "Send to nvALT",
  "version": "1.0.0",
  "description": "Send the page, the selection, or chosen blocks to nvALT as Markdown.",
  "action": {
    "default_title": "Send to nvALT",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/nvALT_16.png",
      "32": "icons/nvALT_32.png"
    }
  },
  "icons": {
    "16": "icons/nvALT_16.png",
    "32": "icons/nvALT_32.png",
    "128": "icons/nvALT_128.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "background": {
    "service_worker": "background.js"
  }
}
